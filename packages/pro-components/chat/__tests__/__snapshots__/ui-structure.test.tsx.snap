// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`chat :ui > ChatActionbar 结构指纹 > chat-actionbar 1`] = `
"<div.t-chat__actions>
  <div.t-space.t-space-horizontal>
    <div.t-space-item>
      <div.t-chat__refresh>
        <button.t-button.t-button--variant-base.t-button--theme-default.t-button--shape-rectangle.t-size-s[href=][type=button]>
          <span.t-button__text>
            <svg.t-icon-refresh />
        <span.t-chat__refresh-line>
  <div.t-space.t-space-horizontal>
    <div.t-space-item>
      <button.t-button.t-button--variant-base.t-button--theme-default.t-button--shape-rectangle.t-size-s.copy-btn[data-clipboard-text=][href=][type=button]>
        <span.t-button__text>
          <svg.t-icon-copy />
  <div.t-space.t-space-horizontal>
    <div.t-space-item>
      <button.t-button.t-button--variant-base.t-button--theme-default.t-button--shape-rectangle.t-size-s[href=][type=button]>
        <span.t-button__text>
          <svg.t-icon-thumb-up />
  <div.t-space.t-space-horizontal>
    <div.t-space-item>
      <button.t-button.t-button--variant-base.t-button--theme-default.t-button--shape-rectangle.t-size-s[href=][type=button]>
        <span.t-button__text>
          <svg.t-icon-thumb-down />"
`;

exports[`chat :ui > ChatItem 结构指纹（含头像 / 昵称 / 时间） > chat-item 1`] = `
"<div.t-chat__inner.user.t-chat__text--variant--base>
  <div.t-chat__avatar>
    <div.t-chat__avatar__box>
      <img.t-chat__avatar-image>
  <div.t-chat__content>
    <div.t-chat__base>
      <span.t-chat__name> "张三"
      <span.t-chat__time> "2024-01-01 10:00:00"
    <div.t-chat__detail>
      <div.t-chat__text>
        <div.t-chat__text--user.other__user>
          <pre> "你好 TDesign""
`;

exports[`chat :ui > ChatList reverse 容器层结构指纹 > chat-list-reverse 1`] = `
"<div.t-chat.t-chat--normal>
  <div.t-chat__list.t-chat__list--reverse>
