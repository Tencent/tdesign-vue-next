exports[`chat :ui > ChatReasoning 结构指纹 > chat-reasoning 1`] = `
"<div.t-chat__detail-reasoning>
  <div.t-collapse.t--border-less.t-chat__detail-reasoning-border>
    <div.t-collapse-panel>
      <div.t-collapse-panel__wrapper>
        <div.t-collapse-panel__header.t-is-clickable>
          <div.t-collapse-panel__header--blank>
          <div.t-collapse-panel__icon.t-collapse-panel__icon--right.t-collapse-panel__icon--active>
            <svg />
        <transition-stub>
          <div.t-collapse-panel__body>
            <div.t-collapse-panel__content>"
`;

exports[`chat :ui > ChatSender 结构指纹 > chat-sender 1`] = `
"<div.t-chat-sender>
  <div.t-chat-sender__textarea>
    <div.t-chat-sender__header>
    <div.t-chat-sender__inner-header>
    <div.t-chat-sender__textarea__wrapper>
      <div.t-textarea>
        <textarea.t-textarea__inner.t-is-default.t-resize-none>
    <div.t-chat-sender__footer>
      <div.t-chat-sender__mode>
      <div.t-chat-sender__button>
        <div.t-chat-sender__button__sendbtn>
          <button.t-button.t-button--variant-text.t-button--theme-default.t-button--shape-rectangle.t-size-s.t-chat-sender__button__default[href=][type=button]>
            <span.t-button__text>
              <svg.t-icon-send-filled />"
`;

exports[`chat :ui > 完整对话场景组合结构指纹 > chat-scene 1`] = `
